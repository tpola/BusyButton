<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:BusyButton.Controls">
    <DataTemplate x:Key="BusyButtonStateContentTemplate"
                  DataType="{x:Type controls:BusyButtonStateContent}">
        <StackPanel x:Name="StateContentRoot"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
            <Viewbox VerticalAlignment="Center"
                     Width="{Binding Owner.IndicatorSize}"
                     Height="{Binding Owner.IndicatorSize}">
                <Viewbox.Style>
                    <Style TargetType="{x:Type Viewbox}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static controls:ButtonState.Busy}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Viewbox.Style>

                <Grid Width="18"
                      Height="18"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <RotateTransform x:Name="BusySpinnerRotation" />
                    </Grid.RenderTransform>

                    <Ellipse Width="16"
                             Height="16"
                             Opacity="0.8"
                             Stroke="{Binding Owner.Foreground}"
                             StrokeDashArray="8 4"
                             StrokeThickness="2.4" />

                    <Grid.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="BusySpinnerRotation"
                                                     Storyboard.TargetProperty="Angle"
                                                     From="0"
                                                     To="360"
                                                     Duration="0:0:2" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Grid.Triggers>
                </Grid>
            </Viewbox>

            <Viewbox VerticalAlignment="Center"
                     Width="{Binding Owner.IndicatorSize}"
                     Height="{Binding Owner.IndicatorSize}">
                <Viewbox.Style>
                    <Style TargetType="{x:Type Viewbox}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static controls:ButtonState.Success}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Viewbox.Style>

                <Path Data="M20 6 9 17l-5-5"
                      Stroke="{Binding Owner.Foreground}"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      StrokeStartLineCap="Round"
                      StrokeThickness="3"
                      Stretch="Uniform" />
            </Viewbox>

            <Viewbox VerticalAlignment="Center"
                     Width="{Binding Owner.IndicatorSize}"
                     Height="{Binding Owner.IndicatorSize}">
                <Viewbox.Style>
                    <Style TargetType="{x:Type Viewbox}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static controls:ButtonState.Error}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Viewbox.Style>

                <Path Data="M18 6 6 18 M6 6l12 12"
                      Stroke="{Binding Owner.Foreground}"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      StrokeStartLineCap="Round"
                      StrokeThickness="3"
                      Stretch="Uniform" />
            </Viewbox>

            <Border Width="{Binding Owner.IndicatorSpacing}">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static controls:ButtonState.Busy}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static controls:ButtonState.Success}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static controls:ButtonState.Error}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Owner.IsStateContentVisible}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <ContentPresenter VerticalAlignment="Center"
                              Content="{Binding Content}"
                              ContentStringFormat="{Binding DataContext.Owner.ContentStringFormat, ElementName=StateContentRoot}"
                              ContentTemplate="{Binding DataContext.ContentTemplate, ElementName=StateContentRoot}"
                              ContentTemplateSelector="{Binding DataContext.Owner.ContentTemplateSelector, ElementName=StateContentRoot}"
                              RecognizesAccessKey="True">
                <ContentPresenter.Style>
                    <Style TargetType="{x:Type ContentPresenter}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.Owner.IsStateContentVisible, ElementName=StateContentRoot}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentPresenter.Style>
            </ContentPresenter>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
